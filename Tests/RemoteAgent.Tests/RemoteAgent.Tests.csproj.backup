<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="AgentCommon">
      <HintPath>..\..\AgentCommon\bin\Debug\Common.dll</HintPath>
    </Reference>
    <Reference Include="AgentCore">
      <HintPath>..\..\AgentCore\bin\Debug\AgentCore.dll</HintPath>
    </Reference>
    <Reference Include="CorePlugins">
      <HintPath>..\..\CorePlugins\bin\Debug\CorePlugins.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
